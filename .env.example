# YouTube Data API v3 key (public trend discovery)
YOUTUBE_API_KEY=

# Google Gemini API key (script generation and scene planning)
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# YouTube OAuth token JSON (only for local testing; keep secret)
# Never commit token.json or client_secret.json.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# Upload visibility: private, unlisted, public
PRIVACY=private
VISUALS=3d
